<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RepositoryUrl>https://github.com/Abderrelmsd/Silo</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Abderrelmsd/Silo</PackageProjectUrl>
    <PackageId>Silo</PackageId>
    <Description>Provider-agnostic, tenant-scoped immutable blob storage (S3, Azure Blob, local filesystem, remote server) with built-in virus scanning and passive ownership.</Description>
    <RootNamespace>Silo</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.12" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.103.4" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
    <PackageReference Include="Cipher" Version="0.1.0" />
    <PackageReference Include="Bedrock" Version="0.1.0" />
  </ItemGroup>
</Project>
